@model UpdateBannerDto
@{
    ViewData["Title"] = "Banner Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <i class="fas fa-edit"></i> Banner Düzenle
    </div>
    <div class="card-body">
        <form asp-action="UpdateBanner" method="post">
            <input type="hidden" asp-for="BannerId">

            <div class="mb-3">
                <label class="form-label">Başlık</label>
                <input type="text" class="form-control" asp-for="Title">
            </div>

            <div class="mb-3">
                <label class="form-label">Alt Başlık</label>
                <input type="text" class="form-control" asp-for="Subtitle">
            </div>

            <div class="mb-3">
                <label class="form-label">Resim URL</label>
                <input type="text" class="form-control" asp-for="ImageUrl">
                <small class="text-muted">Mevcut: <img src="@Model.ImageUrl" style="height: 50px;" class="mt-2"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Buton Metni</label>
                <input type="text" class="form-control" asp-for="ButtonText">
            </div>

            <div class="mb-3">
                <label class="form-label">Buton URL</label>
                <input type="text" class="form-control" asp-for="ButtonUrl">
            </div>

            <div class="mb-3">
                <label class="form-label">Sıra</label>
                <input type="number" class="form-control" asp-for="Order">
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" asp-for="IsActive">
                <label class="form-check-label">Aktif</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-save"></i> Güncelle
                </button>
                <a href="/Admin/Banner/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </div>
        </form>
    </div>
</div>