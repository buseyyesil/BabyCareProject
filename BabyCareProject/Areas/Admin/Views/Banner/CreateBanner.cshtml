@model BabyCareProject.Dtos.BannerDtos.CreateBannerDto

@{
    ViewData["Title"] = "Yeni Banner Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">

            <h4 class="card-title">Yeni Banner Ekle</h4>

            <form asp-area="Admin"
                  asp-controller="Banner"
                  asp-action="CreateBanner"
                  method="post"
                  class="forms-sample">

                <div class="form-group">
                    <label>Başlık</label>
                    <input asp-for="Title" class="form-control" placeholder="Banner başlığı" />
                </div>

                <div class="form-group">
                    <label>Alt Başlık</label>
                    <input asp-for="Subtitle" class="form-control" placeholder="Banner alt başlığı" />
                </div>

                <div class="form-group">
                    <label>Görsel URL</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="~/img/banner1.jpg" />
                </div>

                <div class="form-group">
                    <label>Buton Yazısı</label>
                    <input asp-for="ButtonText" class="form-control" placeholder="Örn: Detaylı Bilgi" />
                </div>

                <div class="form-group">
                    <label>Buton Linki</label>
                    <input asp-for="ButtonUrl" class="form-control" placeholder="/iletisim" />
                </div>

                <div class="form-group">
                    <label>Sıra</label>
                    <input asp-for="Order" type="number" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Aktif mi?</label>
                    <select asp-for="IsActive" class="form-control">
                        <option value="true">Aktif</option>
                        <option value="false">Pasif</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary me-2">Kaydet</button>
                <a asp-area="Admin"
                   asp-controller="Banner"
                   asp-action="Index"
                   class="btn btn-light">Geri Dön</a>

            </form>
        </div>
    </div>
</div>
