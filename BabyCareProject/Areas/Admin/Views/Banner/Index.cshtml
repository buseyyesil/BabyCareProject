@model List<ResultBannerDto>

@{
    ViewData["Title"] = "Banner Listesi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
     
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="mdi mdi-image"></i> Banner Listesi
                </span>

                <a asp-area="Admin"
                   asp-controller="Banner"
                   asp-action="CreateBanner"
                   class="btn btn-primary btn-sm">
                    <i class="mdi mdi-plus"></i> Yeni Banner Ekle
                </a>
            </div>

   
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Görsel</th>
                                <th>Başlık</th>
                                <th>Alt Başlık</th>
                                <th>Buton</th>
                                <th>Sıra</th>
                                <th>Durum</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var i = 0;
                            }

                            @foreach (var item in Model)
                            {
                                i++;
                                <tr>
                                    <td>@i</td>

                                    <td>
                                        <img src="@item.ImageUrl"
                                             style="width:80px;height:50px;object-fit:cover;"
                                             class="img-fluid rounded" />
                                    </td>

                                    <td>@item.Title</td>
                                    <td>@item.Subtitle</td>

                              
                                    <td>
                                        <div class="small">
                                            <div class="fw-bold">@item.ButtonText</div>
                                            <div class="text-muted text-truncate" style="max-width:180px;">
                                                @item.ButtonUrl
                                            </div>
                                        </div>
                                    </td>

                                    <td>@item.Order</td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Pasif</span>
                                        }
                                    </td>

                                    <td class="text-end" style="white-space:nowrap;">
                                        <a asp-area="Admin"
                                           asp-controller="Banner"
                                           asp-action="UpdateBanner"
                                           asp-route-id="@item.BannerId"
                                           class="btn btn-warning btn-sm me-1">
                                            Güncelle
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Banner"
                                           asp-action="DeleteBanner"
                                           asp-route-id="@item.BannerId"
                                           class="btn btn-danger btn-sm"
                                           onclick="return confirm('Silmek istediğine emin misin?')">
                                            Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
