@model List<BabyCareProject.Dtos.TestimonialDtos.ResultTestimonialDto>

@{
    ViewData["Title"] = "Yorumlar";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-comments"></i> Yorum Listesi</span>
        <a href="/Admin/Testimonial/CreateTestimonial" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i> Yeni Ekle
        </a>
    </div>

    <div class="card-body">
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info mb-0">
                Henüz yorum eklenmemiş. Sağ üstten <strong>“Yeni Ekle”</strong> butonunu kullan.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Profil</th>
                            <th>Ad Soyad</th>
                            <th>Pozisyon</th>
                            <th>Yorum</th>
                            <th>Puan</th>
                            <th>Sıra</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             style="width:45px;height:45px;object-fit:cover;"
                                             class="rounded-circle" />
                                    }
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Position</td>
                                <td>
                                    @{
                                        var text = item.Comment ?? "";
                                        if (text.Length > 60)
                                        {
                                            text = text.Substring(0, 60) + "...";
                                        }
                                    }
                                    @text
                                </td>
                                <td>
                                    @for (int star = 1; star <= 5; star++)
                                    {
                                        if (star <= item.Rating)
                                        {
                                            <i class="fas fa-star text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star text-warning"></i>
                                        }
                                    }
                                </td>
                                <td>@item.Order</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <a href="/Admin/Testimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-sm btn-warning">
                                        Güncelle
                                    </a>
                                    <a href="/Admin/Testimonial/DeleteTestimonial/@item.TestimonialId"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Silmek istediğine emin misin?');">
                                        Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
