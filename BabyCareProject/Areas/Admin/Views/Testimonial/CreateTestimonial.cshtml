@model CreateTestimonialDto
@{
    ViewData["Title"] = "Yeni Yorum Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <i class="fas fa-plus"></i> Yeni Yorum Ekle
    </div>
    <div class="card-body">
        <form asp-action="CreateTestimonial" method="post">
            <div class="mb-3">
                <label class="form-label">Ad Soyad</label>
                <input type="text" class="form-control" asp-for="Name" placeholder="Örn: Ayşe Yılmaz">
            </div>

            <div class="mb-3">
                <label class="form-label">Pozisyon</label>
                <input type="text" class="form-control" asp-for="Position" placeholder="Örn: Veli">
            </div>

            <div class="mb-3">
                <label class="form-label">Yorum</label>
                <textarea class="form-control" asp-for="Comment" rows="4" placeholder="Yorum metni..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Resim URL</label>
                <input type="text" class="form-control" asp-for="ImageUrl" placeholder="~/BabyCare-1.0.0/img/testimonial-2.jpg">
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Puan (1-5)</label>
                    <select class="form-select" asp-for="Rating">
                        <option value="5" selected>⭐⭐⭐⭐⭐ (5)</option>
                        <option value="4">⭐⭐⭐⭐ (4)</option>
                        <option value="3">⭐⭐⭐ (3)</option>
                        <option value="2">⭐⭐ (2)</option>
                        <option value="1">⭐ (1)</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Sıra</label>
                    <input type="number" class="form-control" asp-for="Order" value="1">
                </div>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" asp-for="IsActive" checked>
                <label class="form-check-label">Aktif</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Kaydet
                </button>
                <a href="/Admin/Testimonial/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </div>
        </form>
    </div>
</div>