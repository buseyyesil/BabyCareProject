@model CreateFooterGalleryDto
@{
    ViewData["Title"] = "Yeni Galeri Resmi Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <i class="fas fa-plus"></i> Yeni Galeri Resmi Ekle
    </div>
    <div class="card-body">
        <form asp-action="CreateFooterGallery" method="post">
            <div class="mb-3">
                <label class="form-label">Başlık</label>
                <input type="text" class="form-control" asp-for="Title" placeholder="Örn: Etkinlik Fotoğrafı">
            </div>

            <div class="mb-3">
                <label class="form-label">Resim URL</label>
                <input type="text" class="form-control" asp-for="ImageUrl" placeholder="~/BabyCare-1.0.0/img/galary-1.jpg">
            </div>

            <div class="mb-3">
                <label class="form-label">Sıra</label>
                <input type="number" class="form-control" asp-for="Order" value="1">
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Kaydet
                </button>
                <a href="/Admin/FooterGallery/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </div>
        </form>
    </div>
</div>