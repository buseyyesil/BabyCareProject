@model UpdateFooterGalleryDto
@{
    ViewData["Title"] = "Galeri Resmi Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <i class="fas fa-edit"></i> Galeri Resmi Düzenle
    </div>
    <div class="card-body">
        <form asp-action="UpdateFooterGallery" method="post">
            <input type="hidden" asp-for="FooterGalleryId">

            <div class="mb-3">
                <label class="form-label">Başlık</label>
                <input type="text" class="form-control" asp-for="Title">
            </div>

            <div class="mb-3">
                <label class="form-label">Resim URL</label>
                <input type="text" class="form-control" asp-for="ImageUrl">
                <small class="text-muted">Mevcut: <img src="@Model.ImageUrl" style="height: 80px;" class="mt-2 rounded"></small>
            </div>

            <div class="mb-3">
                <label class="form-label">Sıra</label>
                <input type="number" class="form-control" asp-for="Order">
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-save"></i> Güncelle
                </button>
                <a href="/Admin/FooterGallery/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </div>
        </form>
    </div>
</div>