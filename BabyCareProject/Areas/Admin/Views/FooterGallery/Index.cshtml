@model List<ResultFooterGalleryDto>
@{
    ViewData["Title"] = "Galeri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-images"></i> Galeri Listesi</span>
        <a href="/Admin/FooterGallery/CreateFooterGallery" class="btn btn-light btn-sm">
            <i class="fas fa-plus"></i> Yeni Ekle
        </a>
    </div>
    <div class="card-body">
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-3 col-sm-4 col-6 mb-3">
                    <div class="card">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 150px; object-fit: cover;">
                        <div class="card-body p-2">
                            <p class="mb-0 small text-center">@item.Title</p>
                        </div>
                        <div class="card-footer bg-white border-top-0 p-2">
                            <div class="d-flex justify-content-center gap-1">
                                <a href="/Admin/FooterGallery/UpdateFooterGallery/@item.FooterGalleryId" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Admin/FooterGallery/DeleteFooterGallery/@item.FooterGalleryId" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>