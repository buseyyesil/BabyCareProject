@model CreateEventDto
@{
    ViewData["Title"] = "Yeni Etkinlik Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <i class="fas fa-plus"></i> Yeni Etkinlik Ekle
    </div>
    <div class="card-body">
        <form asp-action="CreateEvent" method="post">
            <div class="mb-3">
                <label class="form-label">Etkinlik Adı</label>
                <input type="text" class="form-control" asp-for="Title" placeholder="Örn: Müzik & Resim Atölyesi">
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea class="form-control" asp-for="Description" rows="4" placeholder="Etkinlik açıklaması..."></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Etkinlik Tarihi</label>
                    <input type="date" class="form-control" asp-for="EventDate">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Saat</label>
                    <input type="text" class="form-control" asp-for="EventTime" placeholder="10:00 - 12:00">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Konum</label>
                <input type="text" class="form-control" asp-for="Location" placeholder="Örn: Ana Salon">
            </div>

            <div class="mb-3">
                <label class="form-label">Resim URL</label>
                <input type="text" class="form-control" asp-for="ImageUrl" placeholder="~/BabyCare-1.0.0/img/event-1.jpg">
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Yaş Aralığı (En Az)</label>
                    <input type="number" class="form-control" asp-for="AgeRange" value="3">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Kapasite</label>
                    <input type="number" class="form-control" asp-for="Capacity" value="25">
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Sıra</label>
                    <input type="number" class="form-control" asp-for="Order" value="1">
                </div>

                <div class="col-md-6 mb-3">
                    <div class="form-check mt-4">
                        <input type="checkbox" class="form-check-input" asp-for="IsActive" checked>
                        <label class="form-check-label">Aktif</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Kaydet
                </button>
                <a href="/Admin/Event/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </div>
        </form>
    </div>
</div>