@model CreateInstructorDto
@{
    ViewData["Title"] = "Yeni Eğitmen Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <i class="fas fa-plus"></i> Yeni Eğitmen Ekle
    </div>
    <div class="card-body">
        <form asp-action="CreateInstructor" method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Ad</label>
                    <input type="text" class="form-control" asp-for="FirstName" placeholder="Örn: Ayşe">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Soyad</label>
                    <input type="text" class="form-control" asp-for="LastName" placeholder="Örn: Yılmaz">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Ünvan</label>
                <input type="text" class="form-control" asp-for="Title" placeholder="Örn: İngilizce Öğretmeni">
            </div>

            <div class="mb-3">
                <label class="form-label">Resim URL</label>
                <input type="text" class="form-control" asp-for="ImageUrl" placeholder="~/BabyCare-1.0.0/img/team-1.jpg">
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Kaydet
                </button>
                <a href="/Admin/Instructor/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </div>
        </form>
    </div>
</div>