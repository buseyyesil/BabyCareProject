@model UpdateInstructorDto
@{
    ViewData["Title"] = "Eğitmen Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <i class="fas fa-edit"></i> Eğitmen Düzenle
    </div>
    <div class="card-body">
        <form asp-action="UpdateInstructor" method="post">
            <input type="hidden" asp-for="InstructorId">

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Ad</label>
                    <input type="text" class="form-control" asp-for="FirstName">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Soyad</label>
                    <input type="text" class="form-control" asp-for="LastName">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Ünvan</label>
                <input type="text" class="form-control" asp-for="Title">
            </div>

            <div class="mb-3">
                <label class="form-label">Resim URL</label>
                <input type="text" class="form-control" asp-for="ImageUrl">
                <small class="text-muted">Mevcut: <img src="@Model.ImageUrl" style="height: 50px;" class="mt-2 rounded-circle"></small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-save"></i> Güncelle
                </button>
                <a href="/Admin/Instructor/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </div>
        </form>
    </div>
</div>