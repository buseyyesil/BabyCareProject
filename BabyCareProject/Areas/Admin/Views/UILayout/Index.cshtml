@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <title>BabyCare - Baby Care Center</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Montserrat:wght@200;400;600&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/BabyCare-1.0.0/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/BabyCare-1.0.0/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="~/BabyCare-1.0.0/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="~/BabyCare-1.0.0/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template CSS -->
    <link href="~/BabyCare-1.0.0/css/style.css" rel="stylesheet">
</head>
<body>
    <!-- Spinner Start -->
    <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>
    <!-- Spinner End -->
    <!-- Navbar -->
    @await Component.InvokeAsync("Navbar") 

    <!-- Hero / Banner Section -->
    <div id="home">
        @await Component.InvokeAsync("BannerViewComponent")
    </div>

    <!-- About Section -->
    <div id="about">
        @await Component.InvokeAsync("AboutViewComponent")
    </div>

    <!-- Modal Video -->
    <div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Video</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="ratio ratio-16x9">
                        <iframe class="embed-responsive-item" src="" id="video" allowfullscreen allowscriptaccess="always" allow="autoplay"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Services Section -->
    <div id="services">
        @await Component.InvokeAsync("ServiceViewComponent")
    </div>

    <!-- Programs Section -->
    <div id="programs">
        @await Component.InvokeAsync("ProductViewComponent")
    </div>

    <!-- Events Section -->
    <div id="events">
        @await Component.InvokeAsync("EventViewComponent")
    </div>

    <!-- Team Section -->
    <div id="team">
        @await Component.InvokeAsync("InstructorViewComponent")
    </div>

    <!-- Testimonials Section -->
    <div id="testimonials">
        @await Component.InvokeAsync("TestimonialViewComponent")
    </div>

    <!-- Footer Start -->
    <div class="container-fluid footer py-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">
                @await Component.InvokeAsync("FooterInformationViewComponent")

                <!-- Working Hours -->
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="footer-item">
                        <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">Çalışma Saatleri</h4>
                        <div class="d-flex flex-column p-4 ps-5 text-dark border border-primary" style="border-radius: 50% 20% / 10% 40%;">
                            <p>Pazartesi: 08:00 - 17:00</p>
                            <p>Salı: 08:00 - 17:00</p>
                            <p>Çarşamba: 08:00 - 17:00</p>
                            <p>Perşembe: 08:00 - 17:00</p>
                            <p>Cuma: 08:00 - 17:00</p>
                            <p>Cumartesi: 08:00 - 17:00</p>
                            <p class="mb-0">Pazar: Kapalı</p>
                        </div>
                    </div>
                </div>

                @await Component.InvokeAsync("FooterGalleryViewComponent")
            </div>
        </div>
    </div>
    <!-- Footer End -->
    <!-- Copyright Start -->
    <div class="container-fluid copyright bg-dark py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="text-light">Copyright © @DateTime.Now.Year BabyCare. Tüm hakları saklıdır.</span>
                </div>
                <div class="col-md-6 my-auto text-center text-md-end text-white">
                    Designed By <a class="border-bottom" href="https://htmlcodex.com">HTML Codex</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Copyright End -->
    <!-- Back to Top -->
    <a href="#" class="btn btn-primary border-3 border-primary rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/BabyCare-1.0.0/lib/wow/wow.min.js"></script>
    <script src="~/BabyCare-1.0.0/lib/easing/easing.min.js"></script>
    <script src="~/BabyCare-1.0.0/lib/waypoints/waypoints.min.js"></script>
    <script src="~/BabyCare-1.0.0/lib/lightbox/js/lightbox.min.js"></script>
    <script src="~/BabyCare-1.0.0/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/BabyCare-1.0.0/js/main.js"></script>

    <!-- Video Modal Script -->
    <script>
        $(document).ready(function () {
            $('#videoModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var videoSrc = button.data('src');
                $('#video').attr('src', videoSrc + "?autoplay=1&modestbranding=1&showinfo=0");
            });

            $('#videoModal').on('hide.bs.modal', function () {
                $('#video').attr('src', '');
            });
        });
    </script>
</body>
</html>