@model UpdateServiceDto

@{
    ViewData["Title"] = "Hizmet Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-header">
            <i class="fas fa-edit"></i> Hizmet Düzenle
        </div>

        <div class="card-body">
            <form asp-area="Admin"
                  asp-controller="Service"
                  asp-action="UpdateService"
                  method="post"
                  class="forms-sample">

                <input type="hidden" asp-for="ServiceId" />

                <div class="form-group">
                    <label>Başlık</label>
                    <input type="text"
                           class="form-control"
                           asp-for="Title" />
                </div>

                <div class="form-group">
                    <label>Açıklama</label>
                    <textarea class="form-control"
                              asp-for="Description"
                              rows="4"></textarea>
                </div>

                <div class="form-group">
                    <label>İkon Class</label>
                    <input type="text"
                           class="form-control"
                           asp-for="IconClass" />
                    <small class="text-muted">FontAwesome ikon sınıfı</small>
                </div>

                <div class="form-group">
                    <label>Resim URL</label>
                    <input type="text"
                           class="form-control"
                           asp-for="ImageUrl" />
                </div>

                <div class="form-group">
                    <label>Sıra</label>
                    <input type="number"
                           class="form-control"
                           asp-for="Order" />
                </div>

                <div class="form-group form-check">
                    <input type="checkbox"
                           class="form-check-input"
                           asp-for="IsActive" />
                    <label class="form-check-label">Aktif</label>
                </div>

                <button type="submit" class="btn btn-warning mr-2">
                    <i class="fas fa-save"></i> Güncelle
                </button>

                <a asp-area="Admin"
                   asp-controller="Service"
                   asp-action="Index"
                   class="btn btn-light">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </form>
        </div>
    </div>
</div>
