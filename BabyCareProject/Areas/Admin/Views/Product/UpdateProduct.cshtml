@model BabyCareProject.Dtos.ProductDtos.UpdateProductDto
@{
    ViewData["Title"] = "Program Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <i class="fas fa-edit"></i> Program Düzenle
    </div>
    <div class="card-body">
        <form asp-action="UpdateProduct" method="post">
            <input type="hidden" asp-for="ProductId" />

            <div class="mb-3">
                <label class="form-label">Program Adı</label>
                <input type="text" class="form-control" asp-for="Title">
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea class="form-control" asp-for="Description" rows="4"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Fiyat (₺)</label>
                <input type="number" step="0.01" class="form-control" asp-for="Price">
            </div>

            <div class="mb-3">
                <label class="form-label">Resim URL</label>
                <input type="text" class="form-control" asp-for="ImageUrl">
            </div>

            <div class="mb-3">
                <label class="form-label">Eğitmen Adı</label>
                <input type="text" class="form-control" asp-for="InstructorName">
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-save"></i> Güncelle
                </button>
                <a href="/Admin/Product/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </div>
        </form>
    </div>
</div>
