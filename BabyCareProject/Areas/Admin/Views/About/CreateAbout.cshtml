@model CreateAboutDto

@{
    ViewData["Title"] = "Hakkımızda Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Yeni Hakkımızda Bilgisi Ekle</h4>

            <form asp-area="Admin"
                  asp-controller="About"
                  asp-action="CreateAbout"
                  method="post"
                  class="forms-sample">

                <div class="form-group">
                    <label>Başlık</label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: Çocuklarınız İçin Aydınlık Bir Gelecek" />
                </div>

                <div class="form-group">
                    <label>Açıklama</label>
                    <textarea asp-for="Description" rows="4" class="form-control"
                              placeholder="Merkezinizi anlatan metni girin..."></textarea>
                </div>

                <div class="form-group">
                    <label>Görsel URL</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="~/BabyCare-1.0.0/img/about.jpg" />
                </div>

                <div class="form-group">
                    <label>Video URL (opsiyonel)</label>
                    <input asp-for="VideoUrl" class="form-control" placeholder="https://www.youtube.com/embed/..." />
                </div>

                <div class="row">
                    <div class="col-md-3 form-group">
                        <label>Yıllık Deneyim</label>
                        <input asp-for="YearsOfExperience" type="number" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Mutlu Çocuk</label>
                        <input asp-for="HappyChildren" type="number" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Öğretmen Sayısı</label>
                        <input asp-for="QualifiedTeachers" type="number" class="form-control" />
                    </div>
                    <div class="col-md-3 form-group">
                        <label>Aktif Program</label>
                        <input asp-for="ActivePrograms" type="number" class="form-control" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary me-2">Kaydet</button>
                <a asp-area="Admin"
                   asp-controller="About"
                   asp-action="Index"
                   class="btn btn-light">Geri Dön</a>

            </form>
        </div>
    </div>
</div>
