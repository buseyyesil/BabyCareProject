@model ResultAboutDto

@{
    var imageUrl = Model != null && !string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? Url.Content(Model.ImageUrl)
        : Url.Content("~/BabyCare-1.0.0/img/about.jpg");

   
    var videoUrl = !string.IsNullOrWhiteSpace(Model?.VideoUrl)
        ? Model.VideoUrl
        : "https://www.youtube.com/embed/DWRcNpR6Kdc";
}

<!-- About Start -->
<div class="container-fluid py-5 about bg-light">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
          
            <div class="col-lg-5 wow fadeIn" data-wow-delay="0.1s">
                <div class="video border position-relative">
                    <img src="@imageUrl"
                         alt="@Model?.Title"
                         class="img-fluid w-100"
                         style="min-height:400px; object-fit:cover; border-radius:40px;" />

                    <button type="button"
                            class="btn btn-play position-absolute top-50 start-50 translate-middle"
                            data-bs-toggle="modal"
                            data-src="@videoUrl"
                            data-bs-target="#videoModal">
                        <span></span>
                    </button>
                </div>
            </div>

           
            <div class="col-lg-7 wow fadeIn" data-wow-delay="0.3s">
                <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">
                    Hakkımızda
                </h4>

                <h1 class="text-dark mb-4 display-5">
                    @Model?.Title
                </h1>

                <p class="text-dark mb-4">
                    @Model?.Description
                </p>

                <div class="row mb-4">
                    <div class="col-lg-6">
                        <h6 class="mb-3"><i class="fas fa-check-circle me-2"></i>@Model?.YearsOfExperience Yıl Deneyim</h6>
                        <h6 class="mb-3"><i class="fas fa-check-circle me-2 text-primary"></i>@Model?.QualifiedTeachers Öğretmen</h6>
                        <h6 class="mb-3"><i class="fas fa-check-circle me-2 text-secondary"></i>Güvenli Ortam</h6>
                    </div>
                    <div class="col-lg-6">
                        <h6 class="mb-3"><i class="fas fa-check-circle me-2"></i>@Model?.HappyChildren Mutlu Çocuk</h6>
                        <h6 class="mb-3"><i class="fas fa-check-circle me-2 text-primary"></i>@Model?.ActivePrograms Aktif Program</h6>
                        <h6><i class="fas fa-check-circle me-2 text-secondary"></i>Eğitici Oyunlar</h6>
                    </div>
                </div>

                <a href="#services" class="btn btn-primary px-5 py-3 btn-border-radius">
                    Daha Fazla Detay
                </a>
            </div>
        </div>
    </div>
</div>
<!-- About End -->
<!-- Modal Video -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-0">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Youtube Video</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="ratio ratio-16x9">
                    <iframe class="embed-responsive-item"
                            src=""
                            id="video"
                            allowfullscreen
                            allowscriptaccess="always"
                            allow="autoplay"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal End -->
