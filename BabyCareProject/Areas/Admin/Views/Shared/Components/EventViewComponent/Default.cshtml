@model List<ResultEventDto>

<div class="container-fluid events py-5 bg-light">
    <div class="container py-5">
        <div class="mx-auto text-center wow fadeIn" data-wow-delay="0.1s" style="max-width: 700px;">
            <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">Etkinliklerimiz</h4>
            <h1 class="mb-5 display-3">Yaklaşan Etkinliklerimiz</h1>
        </div>
        <div class="row g-5 justify-content-center">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model.Take(6))
                {
                    var delay = (Model.IndexOf(item) * 2 + 1) * 0.1;
                    <div class="col-md-6 col-lg-6 col-xl-4 wow fadeIn" data-wow-delay="@(delay)s">
                        <div class="events-item bg-primary rounded">
                            <div class="events-inner position-relative">
                                <div class="events-img overflow-hidden rounded-circle position-relative">
                                    <img src="@item.ImageUrl" class="img-fluid w-100 rounded-circle" alt="@item.Title" style="height: 250px; width: 250px; object-fit: cover;">
                                    <div class="event-overlay">
                                        <a href="@item.ImageUrl" data-lightbox="event-@item.EventId"><i class="fas fa-search-plus text-white fa-2x"></i></a>
                                    </div>
                                </div>
                                <div class="px-4 py-2 bg-secondary text-white text-center events-rate">
                                    @item.EventDate.ToString("dd MMM", new System.Globalization.CultureInfo("tr-TR"))
                                </div>
                                <div class="d-flex justify-content-between px-4 py-2 bg-secondary">
                                    <small class="text-white">
                                        <i class="fas fa-calendar me-1 text-primary"></i> @item.EventTime
                                    </small>
                                    <small class="text-white">
                                        <i class="fas fa-map-marker-alt me-1 text-primary"></i> @item.Location
                                    </small>
                                </div>
                            </div>
                            <div class="events-text p-4 border border-primary bg-white border-top-0 rounded-bottom">
                                <a href="#" class="h4">@item.Title</a>
                                <p class="mb-0 mt-3">@item.Description</p>
                                <div class="d-flex justify-content-between mt-3">
                                    <small class="text-muted">
                                        <i class="fa fa-child me-1"></i>Yaş: @item.AgeRange+
                                    </small>
                                    <small class="text-muted">
                                        <i class="fa fa-users me-1"></i>Kapasite: @item.Capacity
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Default Events -->
                <div class="col-md-6 col-lg-6 col-xl-4 wow fadeIn" data-wow-delay="0.1s">
                    <div class="events-item bg-primary rounded">
                        <div class="events-inner position-relative">
                            <div class="events-img overflow-hidden rounded-circle position-relative">
                                <img src="~/BabyCare-1.0.0/img/event-1.jpg" class="img-fluid w-100 rounded-circle" alt="Image">
                                <div class="event-overlay">
                                    <a href="~/BabyCare-1.0.0/img/event-1.jpg" data-lightbox="event-1"><i class="fas fa-search-plus text-white fa-2x"></i></a>
                                </div>
                            </div>
                            <div class="px-4 py-2 bg-secondary text-white text-center events-rate">29 Kas</div>
                            <div class="d-flex justify-content-between px-4 py-2 bg-secondary">
                                <small class="text-white"><i class="fas fa-calendar me-1 text-primary"></i> 10:00 - 12:00</small>
                                <small class="text-white"><i class="fas fa-map-marker-alt me-1 text-primary"></i> Ana Salon</small>
                            </div>
                        </div>
                        <div class="events-text p-4 border border-primary bg-white border-top-0 rounded-bottom">
                            <a href="#" class="h4">Müzik & Resim Atölyesi</a>
                            <p class="mb-0 mt-3">Çocuklarınız için eğlenceli müzik ve resim atölyesi. Yaratıcılıklarını geliştiriyorlar.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-4 wow fadeIn" data-wow-delay="0.3s">
                    <div class="events-item bg-primary rounded">
                        <div class="events-inner position-relative">
                            <div class="events-img overflow-hidden rounded-circle position-relative">
                                <img src="~/BabyCare-1.0.0/img/event-2.jpg" class="img-fluid w-100 rounded-circle" alt="Image">
                                <div class="event-overlay">
                                    <a href="~/BabyCare-1.0.0/img/event-2.jpg" data-lightbox="event-1"><i class="fas fa-search-plus text-white fa-2x"></i></a>
                                </div>
                            </div>
                            <div class="px-4 py-2 bg-secondary text-white text-center events-rate">05 Ara</div>
                            <div class="d-flex justify-content-between px-4 py-2 bg-secondary">
                                <small class="text-white"><i class="fas fa-calendar me-1 text-primary"></i> 14:00 - 16:00</small>
                                <small class="text-white"><i class="fas fa-map-marker-alt me-1 text-primary"></i> Bahçe</small>
                            </div>
                        </div>
                        <div class="events-text p-4 border border-primary bg-white border-top-0 rounded-bottom">
                            <a href="#" class="h4">Eğitimin Önemi</a>
                            <p class="mb-0 mt-3">Çocuklarımız için eğitimin önemini anlatan interaktif etkinlik.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-6 col-xl-4 wow fadeIn" data-wow-delay="0.5s">
                    <div class="events-item bg-primary rounded">
                        <div class="events-inner position-relative">
                            <div class="events-img overflow-hidden rounded-circle position-relative">
                                <img src="~/BabyCare-1.0.0/img/event-3.jpg" class="img-fluid w-100 rounded-circle" alt="Image">
                                <div class="event-overlay">
                                    <a href="~/BabyCare-1.0.0/img/event-3.jpg" data-lightbox="event-1"><i class="fas fa-search-plus text-white fa-2x"></i></a>
                                </div>
                            </div>
                            <div class="px-4 py-2 bg-secondary text-white text-center events-rate">12 Ara</div>
                            <div class="d-flex justify-content-between px-4 py-2 bg-secondary">
                                <small class="text-white"><i class="fas fa-calendar me-1 text-primary"></i> 10:00 - 12:00</small>
                                <small class="text-white"><i class="fas fa-map-marker-alt me-1 text-primary"></i> Sınıf</small>
                            </div>
                        </div>
                        <div class="events-text p-4 border border-primary bg-white border-top-0 rounded-bottom">
                            <a href="#" class="h4">Çocuk Sağlığı Bilinci</a>
                            <p class="mb-0 mt-3">Çocuk sağlığı ve hijyen konusunda bilinçlendirme etkinliği.</p>
                        </div>
                    </div>
                </div>
               
            }
        </div>
    </div>
</div>