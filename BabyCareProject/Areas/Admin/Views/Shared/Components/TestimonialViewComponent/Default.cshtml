@model List<ResultTestimonialDto>

<div class="container-fluid testimonial py-5">
    <div class="container py-5">
        <div class="mx-auto text-center" style="max-width: 700px;">
            <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">
                Yorumlarımız
            </h4>
            <h1 class="mb-5 display-3">Veliler Hakkımızda Ne Diyor</h1>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="owl-carousel testimonial-carousel">
                @foreach (var item in Model)
                {
                    <div class="testimonial-item img-border-radius bg-light border border-primary p-4">
                        <div class="p-4 position-relative">
                            <i class="fa fa-quote-right fa-2x text-primary position-absolute"
                               style="top: 15px; right: 15px;"></i>

                            <div class="d-flex align-items-center">
                                <div class="border border-primary bg-white rounded-circle">
                                    <img src="@item.ImageUrl"
                                         class="rounded-circle p-2"
                                         style="width: 80px; height: 80px; border-style: dotted; border-color: var(--bs-primary); object-fit: cover;"
                                         alt="@item.Name" />
                                </div>

                                <div class="ms-4">
                                    <h4 class="text-dark">@item.Name</h4>
                                    <p class="m-0 pb-3">@item.Position</p>

                                    <div class="d-flex pe-5">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= item.Rating)
                                            {
                                                <i class="fas fa-star text-primary"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-primary"></i>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="border-top border-primary mt-4 pt-3">
                                <p class="mb-0">@item.Comment</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center mt-4">
                <p class="text-muted">
                    Henüz yorum eklenmemiş. Admin panelinden yorum eklediğinde burada görünecek.
                </p>
            </div>
        }
    </div>
</div>
