@model List<ResultFooterGalleryDto>

@if (Model != null && Model.Any())
{
    <!-- Footer Gallery Start -->
    <div class="col-md-6 col-lg-4 col-xl-3">
        <div class="footer-item">
            <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">GALERİMİZ</h4>
            <div class="row g-3">
                @foreach (var item in Model.Take(6))
                {
                    <div class="col-4">
                        <div class="footer-galary-img rounded-circle border border-primary">
                            <img src="@item.ImageUrl" class="img-fluid rounded-circle p-2" alt="@item.Title" style="height: 80px; width: 80px; object-fit: cover;">
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <!-- Footer Gallery End -->
}
else
{
    <div class="col-md-6 col-lg-4 col-xl-3">
        <div class="footer-item">
            <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">GALERİMİZ</h4>
            <div class="row g-3">
                @for (int i = 1; i <= 6; i++)
                {
                    <div class="col-4">
                        <div class="footer-galary-img rounded-circle border border-primary">
                            <img src="~/BabyCare-1.0.0/img/galary-@(i).jpg" class="img-fluid rounded-circle p-2" alt="">
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}