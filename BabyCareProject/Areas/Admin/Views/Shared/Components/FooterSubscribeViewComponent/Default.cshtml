<!-- Footer Subscribe Start -->
<div class="col-lg-3 col-md-6">
    <h4 class="text-white mb-4">Bülten</h4>
    <p>Yeni etkinlikler ve haberlerden haberdar olmak için abone olun!</p>
    <div class="position-relative w-100">
        <input class="form-control bg-transparent border-light w-100 py-3 ps-4 pe-5"
               type="email"
               placeholder="E-posta adresiniz"
               id="subscribeEmail">
        <button type="button"
                class="btn btn-primary py-2 position-absolute top-0 end-0 mt-2 me-2"
                onclick="subscribeNewsletter()">
            Abone Ol
        </button>
    </div>
</div>

<script>
    function subscribeNewsletter() {
        var email = document.getElementById('subscribeEmail').value;
        if(email) {
            alert('Teşekkürler! E-posta: ' + email);
         
        } else {
            alert('Lütfen e-posta adresinizi girin.');
        }
    }
</script>
<!-- Footer Subscribe End -->
