@model CreateFooterInformationDto
@{
    ViewData["Title"] = "İletişim Bilgisi Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card">
    <div class="card-header">
        <i class="fas fa-plus"></i> İletişim Bilgisi Ekle
    </div>
    <div class="card-body">
        <form asp-action="CreateFooterInformation" method="post">
            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea class="form-control" asp-for="Description" rows="4" placeholder="Şirket hakkında kısa açıklama..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Adres</label>
                <input type="text" class="form-control" asp-for="Address" placeholder="Yahya Kaptan Mah. Atatürk Blv. No:123, İzmit/Kocaeli">
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Telefon</label>
                    <input type="text" class="form-control" asp-for="Phone" placeholder="+90 (262) 123 45 67">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" asp-for="Email" placeholder="info@babycare.com">
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Kaydet
                </button>
                <a href="/Admin/FooterInformation/Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Geri
                </a>
            </div>
        </form>
    </div>
</div>