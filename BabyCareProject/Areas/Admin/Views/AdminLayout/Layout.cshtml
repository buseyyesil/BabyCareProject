<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] - BabyCare Admin Panel</title>


    <link rel="stylesheet" href="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/vendors/flag-icon-css/css/flag-icon.min.css" />
    <link rel="stylesheet" href="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/vendors/css/vendor.bundle.base.css" />
    <link rel="stylesheet" href="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/vendors/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/css/style.css" />
    <link rel="shortcut icon" href="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/images/favicon.png" />
</head>
<body>
    <div class="container-scroller">
        <!-- Sidebar -->
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            <div class="text-center sidebar-brand-wrapper d-flex align-items-center">
                <a class="sidebar-brand brand-logo" href="/Admin/About">
                    <h3 class="text-white mt-2"><i class="mdi mdi-baby"></i> BabyCare</h3>
                </a>
                <a class="sidebar-brand brand-logo-mini pl-4 pt-3" href="/Admin/About">
                    <i class="mdi mdi-baby text-white"></i>
                </a>
            </div>
            <ul class="nav">
                <li class="nav-item nav-profile">
                    <a href="#" class="nav-link">
                        <div class="nav-profile-text d-flex flex-column pr-3">
                            <span class="font-weight-medium mb-2">Admin Panel</span>
                            <span class="font-weight-normal">BabyCare Yönetim</span>
                        </div>
                    </a>
                </li>

                <!-- Hakkımızda -->
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/About">
                        <i class="mdi mdi-information menu-icon"></i>
                        <span class="menu-title">Hakkımızda</span>
                    </a>
                </li>

                <!-- Hizmetler -->
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Service">
                        <i class="mdi mdi-cog menu-icon"></i>
                        <span class="menu-title">Hizmetler</span>
                    </a>
                </li>

                <!-- Programlar -->
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Product">
                        <i class="mdi mdi-package menu-icon"></i>
                        <span class="menu-title">Programlar</span>
                    </a>
                </li>

                <!-- Eğitmenler -->
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Instructor">
                        <i class="mdi mdi-account-multiple menu-icon"></i>
                        <span class="menu-title">Eğitmenler</span>
                    </a>
                </li>

                <!-- DİĞER MODÜLLER -->
                <li class="nav-item">
                    <span class="nav-link disabled">
                        <span class="menu-title text-muted">--- DİĞER ---</span>
                    </span>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Banner">
                        <i class="mdi mdi-image-multiple menu-icon"></i>
                        <span class="menu-title">Banner</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Event">
                        <i class="mdi mdi-calendar menu-icon"></i>
                        <span class="menu-title">Etkinlikler</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Testimonial">
                        <i class="mdi mdi-comment-multiple menu-icon"></i>
                        <span class="menu-title">Yorumlar</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/Admin/Footer">
                        <i class="mdi mdi-page-layout-footer menu-icon"></i>
                        <span class="menu-title">Footer</span>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Panel -->
        <div class="container-fluid page-body-wrapper">
            <!-- Top Navbar -->
            <nav class="navbar col-lg-12 col-12 p-lg-0 fixed-top d-flex flex-row">
                <div class="navbar-menu-wrapper d-flex align-items-center justify-content-between">
                    <a class="navbar-brand brand-logo-mini align-self-center d-lg-none" href="/Admin/About">
                        <i class="mdi mdi-baby"></i>
                    </a>
                    <button class="navbar-toggler navbar-toggler align-self-center mr-2" type="button" data-toggle="minimize">
                        <i class="mdi mdi-menu"></i>
                    </button>

                    <ul class="navbar-nav navbar-nav-left header-links">
                        <li class="nav-item d-none d-md-flex">
                            <a href="/Admin/UILayout" class="nav-link" target="_blank">
                                <i class="mdi mdi-eye"></i> Siteyi Görüntüle
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav navbar-nav-right ml-lg-auto">
                        <li class="nav-item  nav-profile border-0">
                            <a class="nav-link" href="#" data-toggle="dropdown" id="profileDropdown">
                                <i class="mdi mdi-account"></i>
                                <span class="profile-name">Admin</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="profileDropdown">
                                <div class="dropdown-item d-flex align-items-center">
                                    <i class="mdi mdi-settings mr-2"></i> Ayarlar
                                </div>
                                <div class="dropdown-divider"></div>
                                <div class="dropdown-item d-flex align-items-center">
                                    <i class="mdi mdi-logout mr-2"></i> Çıkış Yap
                                </div>
                            </div>
                        </li>
                    </ul>

                    <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                        <span class="mdi mdi-menu"></span>
                    </button>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="main-panel">
                <div class="content-wrapper pb-0">
                    @RenderBody()
                </div>

                <!-- Footer -->
                <footer class="footer">
                    <div class="d-sm-flex justify-content-center justify-content-sm-between">
                        <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">
                            Copyright © @DateTime.Now.Year BabyCare. Tüm hakları saklıdır.
                        </span>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <!-- Breeze Admin Template Scripts -->
    <script src="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/js/off-canvas.js"></script>
    <script src="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/js/hoverable-collapse.js"></script>
    <script src="~Breeze-Free-Bootstrap-Admin-Template-1.0.0/admin/assets/js/misc.js"></script>

    <script>
      
        $(document).ready(function() {
            var currentPath = window.location.pathname;
            $('.sidebar .nav-link').each(function() {
                var href = $(this).attr('href');
                if (href && currentPath.indexOf(href) !== -1) {
                    $(this).addClass('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>